DATABASE_URL=postgres://fashion:fashion@db:5432/fashion
# Optional fallback. Preferably set the key in Admin → Cài đặt (stored encrypted in the database and used first).
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-2025-04-14
# Extra chat models an agent can be switched to in Admin → AI Agents (comma-separated); OPENAI_CHAT_MODEL is always allowed.
OPENAI_ALLOWED_MODELS=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_OUTPUT_TOKENS=500
OPENAI_TIMEOUT_MS=20000
OPENAI_MAX_RETRIES=1
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SIMILARITY=0.45
MAX_CONTEXT_CHUNKS=5
MAX_CONTEXT_TOKENS=1200
EMBEDDING_BATCH_SIZE=50
EMBEDDING_TIMEOUT_MS=20000
EMBEDDING_MAX_RETRIES=1
KNOWLEDGE_SAFETY_REVIEW_ENABLED=true
RAG_POLICY_LIFECYCLE_ENABLED=true
RAG_METRICS_ENABLED=true
# Experimental retrieval features; keep disabled until eval shows a regression they solve.
RAG_RERANK_ENABLED=false
RAG_QUERY_REWRITE_ENABLED=false
MAX_HISTORY_TURNS=10
MAX_HISTORY_MESSAGES=20
CHAT_RATE_LIMIT=30
CHAT_RATE_WINDOW_SECONDS=600
MAX_USER_MESSAGE_CHARS=2000
UPLOAD_MAX_BYTES=10485760
UPLOAD_RATE_LIMIT=10
UPLOAD_RATE_WINDOW_SECONDS=3600
MCP_URL=http://mcp:3001/mcp
# Generate a random value of at least 24 characters. This is an internal service secret:
# never expose it to the browser or place it in Admin settings.
INTERNAL_MCP_TOKEN=replace-with-a-long-random-internal-mcp-token
RATE_LIMIT_BACKEND=postgres
# HMAC key for rate-limit buckets (defaults to ADMIN_SESSION_SECRET); per-IP cap on admin API calls per minute.
RATE_LIMIT_SECRET=
ADMIN_API_RATE_LIMIT=300
# Rotation only: the old INTERNAL_MCP_TOKEN, still accepted by MCP until web/worker restarted (see README).
INTERNAL_MCP_TOKEN_PREVIOUS=
# Debug only. Logs never contain chat text by default; true adds a redacted copy (names/addresses are NOT detected).
LOG_CHAT_TEXT=false
# Simulated online payment: the customer chooses success/failure on the order page. Demo only; never true in production.
# false = checkout (web and chat) accepts COD only.
PAYMENT_SIMULATION_ENABLED=false
AGENT_SUMMARY_ENABLED=true
# Circuit breakers: observe (track/report only) → enforce (stop calling a failing dependency for CIRCUIT_OPEN_SECONDS).
CIRCUIT_BREAKER_MODE=observe
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_WINDOW_SECONDS=30
CIRCUIT_OPEN_SECONDS=30
# Alerts checked by the worker every ALERT_CHECK_INTERVAL_SECONDS; listed in Admin → Monitoring.
ALERT_CHECK_INTERVAL_SECONDS=300
ALERT_WINDOW_MINUTES=15
ALERT_MIN_SAMPLES=10
ALERT_DEPENDENCY_FAILURE_RATE=0.2
ALERT_CHAT_P95_MS=15000
ALERT_APPROVAL_MAX_AGE_MINUTES=240
ALERT_DEDUPE_MINUTES=60
# Optional Slack/Discord incoming webhook (payload has numbers only).
ALERT_WEBHOOK_URL=
# Prometheus (`docker compose --profile observability up -d`). Empty METRICS_TOKEN = /api/metrics answers 404.
METRICS_TOKEN=
GRAFANA_ADMIN_PASSWORD=
GRAFANA_URL=
AGENT_SUMMARIZE_AFTER_MESSAGES=24
AGENT_KEEP_RECENT_MESSAGES=16
# MCP servers added in Admin → MCP Server may not point at private/loopback addresses unless listed here (host or host:port,
# comma-separated). The host of MCP_URL is always allowed.
MCP_ALLOWED_HOSTS=
AGENT_MAX_STEPS=5
AGENT_MAX_TOOL_CALLS=5
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
# Encrypts secrets stored in the database (e.g. the OpenAI key). Defaults to ADMIN_SESSION_SECRET.
SETTINGS_ENCRYPTION_KEY=
# Only needed for `docker compose --profile tunnel up`
CLOUDFLARE_TUNNEL_TOKEN=
